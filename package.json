{
  "name": "session-booking-api",
  "version": "1.0.0",
  "description": "REST API for booking sessions with teachers (Node.js, TypeScript, Express, MongoDB, Mongoose)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^8.24.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9"
  }
}
